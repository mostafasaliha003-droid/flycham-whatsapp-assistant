FROM mcr.microsoft.com/playwright:v1.64.0-noble

WORKDIR /app
COPY package.json package-lock.json ./
COPY scripts/install-mrz-model.js ./scripts/install-mrz-model.js
RUN npm ci --omit=dev
COPY src ./src

RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils && rm -rf /var/lib/apt/lists/*
COPY test ./test
COPY scripts ./scripts
COPY docs ./docs
COPY .env.example .gitignore README.md THIRD_PARTY_MRZ_MODEL.md Dockerfile.worker render.yaml ./
COPY .ci/security-fix-validation/run-ci.cjs /report/run-ci.cjs
COPY .ci/security-fix-validation/report-server.cjs /report/report-server.cjs
COPY .ci/security-fix-validation/source-manifest.json /report/source-manifest.json
RUN useradd --user-group --create-home --uid 10001 remal-validator && chown -R remal-validator:remal-validator /app /report
USER remal-validator
RUN node /report/run-ci.cjs 7fa1127e675fdfa9ba21b4c13cc0119d114ac56c
CMD ["node", "/report/report-server.cjs"]
