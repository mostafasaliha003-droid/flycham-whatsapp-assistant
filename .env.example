# Local server
PORT=3000
NODE_ENV=development

# WhatsApp Cloud API webhook settings
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0

# Safety: outbound messages are logged and not sent unless set to false.
DRY_RUN=true

# Quote handling. No booking or ticketing is implemented.
QUOTE_CURRENCY=USD
QUOTE_MARGIN_TYPE=fixed
QUOTE_MARGIN_VALUE=0


# Optional customer document upload return destination (business WhatsApp digits).
# Distinct from the office owner's visa OTP number. No '+' or spaces needed.
RAAD_DOCUMENT_UPLOAD_WHATSAPP_NUMBER=

# Optional controlled Ismail wording; no new provider calls. Disabled by default.
ISMAIL_CONVERSATION_STYLE_ENABLED=false

# Optional literal MRZ transcription. These defaults perform no OpenAI requests.
# Activation also requires a reviewed policy fingerprint, current upload consent,
# the existing privately managed OPENAI_API_KEY, and an offline-reconciled ledger.
# Do not paste credentials into this file or chat. See docs/assistant/MRZ-PRODUCTION-2026-10-31.md.
RAAD_MRZ_PROVIDER=local
RAAD_MRZ_PRODUCTION_ENABLED=false
# RAAD_MRZ_PRODUCTION_POLICY_SHA256=a70431e5ed8b897e4674e15a2734cf3fc61436b34e9010a8af4149c32b7ca461
# RAAD_MRZ_PRODUCTION_BUDGET_USD=<separately approved total cap, including historical spend>
# RAAD_MRZ_PRODUCTION_BUDGET_PATH=<absolute sibling path of the encrypted assistant state>

# For a separately approved, isolated Raad test service only:
# RAAD_EXECUTION_MODE=non_submitting_test
# Dedicated test transport is mandatory for worker admission in that mode.
# RAAD_TEST_MAIN_URL=
# RAAD_TEST_APPROVED_MAIN_ORIGIN=
# RAAD_TEST_JOB_BRIDGE_KEY=
# Test keys are managed privately; never copy production keys or put them here.
# DRY_RUN alone does not disable visa dispatch or government save operations.
# Keep visa execution disabled in local tests; do not copy live credentials here.
# SAUDI_VISA_ENABLED=false
# RAAD_VISA_AUTOMATION_ENABLED=false
