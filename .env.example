# Local server
PORT=3000
NODE_ENV=development

# WhatsApp Cloud API webhook settings
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0

# Safety: outbound messages are logged and not sent unless set to false.
DRY_RUN=true

# Quote handling. No booking or ticketing is implemented.
QUOTE_CURRENCY=USD
QUOTE_MARGIN_TYPE=fixed
QUOTE_MARGIN_VALUE=0


# Optional customer document upload return destination (business WhatsApp digits).
# Distinct from the office owner's visa OTP number. No '+' or spaces needed.
RAAD_DOCUMENT_UPLOAD_WHATSAPP_NUMBER=

# Customer experience: assistants remain available 24/7; staff hours are Dubai time.
STAFF_HOURS_START=10
STAFF_HOURS_END=22
# Audio is transient and redacted; off disables transcription. OGG uses Gemini.
VOICE_TRANSCRIPTION=on
VOICE_TRANSCRIPTION_PROVIDERS=cline,gemini
VOICE_GEMINI_MODEL=gemini-2.5-flash
# Leave empty until a synthetic voice probe and owner approval establish support.
CLINE_AUDIO_MODEL=
# Evaluate without changing production models:
# node scripts/evaluate-cline-models.js
# node scripts/probe-voice-models.js synthetic.mp3 synthetic.ogg
