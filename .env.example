# Local server
PORT=3000
NODE_ENV=development

# WhatsApp Cloud API webhook settings
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0

# Safety: outbound messages are logged and not sent unless set to false.
DRY_RUN=true

# Quote handling. No booking or ticketing is implemented.
QUOTE_CURRENCY=USD
QUOTE_MARGIN_TYPE=fixed
QUOTE_MARGIN_VALUE=0

# Air Arabia: AED per passenger, once on the complete itinerary total.
# Used by the pricing helper; automatic portal quoting is not connected yet.
AIR_ARABIA_MARGIN_AED=25
